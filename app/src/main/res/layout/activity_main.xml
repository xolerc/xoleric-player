<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep">

    <!-- 1) Vertikal fon animatsiyasi (eng pastda) -->
    <com.xoleric.anim.VerticalBgView
        android:id="@+id/bgAnim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2) mydrime LOADER (to'liq ekranda, icon emas) -->
    <com.xoleric.anim.LoaderView
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/content" />

    <!-- 3) Asosiy kontent -->
    <RelativeLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible">

        <!-- Sarlavha -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/logoTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XOLERIC"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:letterSpacing="0.22"
                android:textStyle="bold"
                android:typeface="sans" />

            <TextView
                android:id="@+id/subTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/logoTxt"
                android:layout_marginTop="2dp"
                android:text="M U S I Q A   P L E Y E R"
                android:textColor="@color/steel"
                android:textSize="10sp"
                android:letterSpacing="0.32" />
        </RelativeLayout>

        <!-- Albom katta rasm + joriy trek (premium kart) -->
        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBar"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp">

            <FrameLayout
                android:id="@+id/artFrame"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_art_card"
                android:foreground="@drawable/bg_art_scrim">

                <ImageView
                    android:id="@+id/albumArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_art_placeholder" />

                <TextView
                    android:id="@+id/nowPlayingTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_tag"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="▶ HOZIR O'YNAYAPTI"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:letterSpacing="0.14" />
            </FrameLayout>

            <TextView
                android:id="@+id/trackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tanlangan trek"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/trackArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Artist"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Progress + pleyer tugmalari -->
        <LinearLayout
            android:id="@+id/playerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/heroCard"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/steel"
                android:thumbTint="@color/white"
                android:progressBackgroundTint="@color/bg_elevated" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/timePos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_prev"
                    android:contentDescription="Oldingi" />

                <ImageButton
                    android:id="@+id/btnPlay"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:background="@drawable/bg_play"
                    android:src="@drawable/ic_play"
                    android:contentDescription="O'ynat" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_next"
                    android:contentDescription="Keyingi" />

                <TextView
                    android:id="@+id/timeDur"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Treklar ro'yxati -->
        <ListView
            android:id="@+id/songList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/playerControls"
            android:layout_marginTop="10dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:cacheColorHint="@android:color/transparent"
            android:listSelector="@drawable/bg_list_selector" />

    </RelativeLayout>
</RelativeLayout>
